# eBay — https://developer.ebay.com
# Option A: Auth'n'Auth (simpler — recommended for personal use)
#   Get token from User Tokens tab > Auth'n'Auth > Sign in to Production
EBAY_AUTH_TOKEN=
# Option B: OAuth — REQUIRED for the Sell REST APIs (Promoted Listings via
#   Marketing, send-offer-to-watchers via Negotiation). Auth'n'Auth cannot reach these.
#   Set both: Trading calls use EBAY_AUTH_TOKEN, REST calls use OAuth.
#   In the eBay dev portal, the RuName's "Your auth accepted URL" must be
#   https://localhost:8888/callback  (https, not http — the local callback
#   server runs TLS with a self-signed cert, and eBay rejects plain http)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RUNAME=
# Force a mode instead of auto-detecting (authnauth | oauth)
# EBAY_AUTH_MODE=
# Set to "true" to use eBay sandbox for testing
# EBAY_SANDBOX=false
